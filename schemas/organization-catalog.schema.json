{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fides.community/schemas/organization-catalog/v1",
  "title": "FIDES Organization Catalog Schema",
  "description": "Schema for organization catalog entries contributed by community members.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "organization"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://fides.community/schemas/organization-catalog/v1"
    },
    "organization": {
      "$ref": "#/$defs/Organization"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "CertificationEvidence": {
      "description": "Optional proof: public URL (page or PDF) or reference to a verifiable credential.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url"],
          "properties": {
            "kind": { "const": "url" },
            "url": {
              "type": "string",
              "format": "uri",
              "description": "Web page, PDF, or other document location"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "description": "Optional short label for the link"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "format", "credentialUri"],
          "properties": {
            "kind": { "const": "verifiable_credential" },
            "format": {
              "type": "string",
              "enum": ["jwt_vc", "sd_jwt_vc", "ldp_vc", "other"],
              "description": "Credential representation"
            },
            "credentialUri": {
              "type": "string",
              "format": "uri",
              "description": "HTTPS URL to retrieve or resolve the credential"
            },
            "notes": {
              "type": "string",
              "minLength": 1,
              "description": "Optional context (issuer, type, etc.)"
            }
          }
        }
      ]
    },
    "OrganizationCertification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["iso27001", "iso27701", "qtsp", "soc2", "diacc"],
          "description": "iso27001: ISO/IEC 27001 (ISMS). iso27701: ISO/IEC 27701 (privacy extension). qtsp: Qualified Trust Service Provider under EU eIDAS. soc2: SOC 2 attestation. diacc: DIACC Certified under the Pan-Canadian Trust Framework (PCTF)."
        },
        "evidence": {
          "$ref": "#/$defs/CertificationEvidence"
        },
        "details": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": { "const": "qtsp" }
            },
            "required": ["code"]
          },
          "then": {
            "properties": {
              "details": { "$ref": "#/$defs/QtspCertificationDetails" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": { "const": "diacc" }
            },
            "required": ["code"]
          },
          "then": {
            "properties": {
              "details": { "$ref": "#/$defs/DiaccCertificationDetails" }
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "code": { "enum": ["qtsp", "diacc"] }
              },
              "required": ["code"]
            }
          },
          "then": {
            "not": {
              "required": ["details"]
            }
          }
        }
      ]
    },
    "QtspTrustService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^Q(?:_|[A-Z0-9]).*",
          "description": "Qualified trust service legal type code from the EU Trust List API (EFDA), including variants like Q_* and QEAA."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Optional human-readable name for this trust service."
        }
      }
    },
    "QtspCertificationDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trustServices"],
      "properties": {
        "trustServices": {
          "type": "array",
          "minItems": 1,
          "description": "Active qualified trust services declared for this QTSP entry.",
          "items": { "$ref": "#/$defs/QtspTrustService" }
        }
      }
    },
    "DiaccCertifiedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component"],
      "properties": {
        "component": {
          "type": "string",
          "enum": ["digital_wallet", "verified_person", "privacy"],
          "description": "DIACC PCTF certified component: digital_wallet (PCTF Digital Wallet Component), verified_person (PCTF Verified Person Component), privacy (PCTF Privacy Component)."
        },
        "loa": {
          "type": "string",
          "minLength": 1,
          "description": "Level of Assurance as published by DIACC for this component (e.g. LOA3). Omit when the certificate states no level."
        },
        "evidence": {
          "$ref": "#/$defs/CertificationEvidence"
        }
      }
    },
    "DiaccCertificationDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components"],
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "description": "Certified DIACC PCTF components declared for this organization.",
          "items": { "$ref": "#/$defs/DiaccCertifiedComponent" }
        }
      }
    },
    "OrganizationIdentifiers": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Optional business and technical identifiers; include only keys you publish.",
      "properties": {
        "business_registration_number": {
          "type": "string",
          "minLength": 1,
          "description": "Trade register / company registration number (jurisdiction-specific)"
        },
        "vat_number": {
          "type": "string",
          "minLength": 1,
          "description": "VAT / sales tax identification number"
        },
        "lei": {
          "type": "string",
          "minLength": 1,
          "description": "Legal Entity Identifier (ISO 17442)"
        },
        "eori": {
          "type": "string",
          "minLength": 1,
          "description": "Economic Operators Registration and Identification (EU customs)"
        },
        "euid": {
          "type": "string",
          "minLength": 1,
          "description": "European Unique Identifier for a legal entity"
        },
        "duns": {
          "type": "string",
          "minLength": 1,
          "description": "D-U-N-S number"
        },
        "gln": {
          "type": "string",
          "minLength": 1,
          "description": "Global Location Number (GS1)"
        },
        "did": {
          "type": "string",
          "pattern": "^did:",
          "description": "Decentralized Identifier"
        }
      }
    },
    "OrganizationSectorCode": {
      "type": "string",
      "enum": [
        "public_sector",
        "finance",
        "trade",
        "supply_chain",
        "manufacturing",
        "energy",
        "agriculture",
        "food",
        "retail",
        "healthcare",
        "education",
        "construction",
        "mobility",
        "digital"
      ],
      "description": "Closed sector taxonomy; pick one sector per organization."
    },
    "OrganizationMedia": {
      "type": "object",
      "description": "Promotional media (Pro tier in public export)",
      "additionalProperties": false,
      "properties": {
        "videos": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "format": "uri"
          },
          "description": "Demo or promotional video URLs"
        },
        "images": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "format": "uri"
          },
          "description": "Screenshot or product image URLs"
        }
      },
      "anyOf": [
        {
          "required": ["videos"],
          "properties": {
            "videos": {
              "minItems": 1
            }
          }
        },
        {
          "required": ["images"],
          "properties": {
            "images": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "OrganizationEcosystemRoleCode": {
      "type": "string",
      "enum": [
        "personal_wallet_provider",
        "business_wallet_provider",
        "vc_type_authority",
        "issuer",
        "relying_party",
        "idv_provider",
        "kyb_provider",
        "system_integrator",
        "consultancy",
        "software_vendor",
        "business_registry",
        "industry_association",
        "standards_development_organization",
        "conformity_scheme_owner",
        "national_accreditation_body",
        "certification_body",
        "conformity_assessment_body",
        "eudi_wallet_intermediary",
        "eidas_trust_service_provider",
        "trust_infrastructure_provider",
        "interop_testbed_operator"
      ],
      "description": "Ecosystem role the organization performs in the digital identity / trust landscape."
    },
    "Organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sectors"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^org:[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Unique identifier. Format: org:<code> where code matches the community-catalogs directory name."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name of the organization"
        },
        "sectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "At least one sector from the closed list. Contributors should pick the best fit; digital identity / trust providers often also map to digital.",
          "items": { "$ref": "#/$defs/OrganizationSectorCode" }
        },
        "legalName": {
          "type": "string",
          "description": "Official legal / registered name (e.g. trade register)"
        },
        "description": {
          "type": "string",
          "description": "Short description of the organization"
        },
        "identifiers": {
          "$ref": "#/$defs/OrganizationIdentifiers"
        },
        "website": {
          "type": "string",
          "format": "uri"
        },
        "logo": {
          "type": "string",
          "format": "uri"
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$|^EU$",
          "description": "ISO 3166-1 alpha-2 country code, or EU for pan-European"
        },
        "certifications": {
          "type": "array",
          "description": "Declared certifications from the closed list; at most one entry per code (first wins if duplicates are submitted).",
          "items": { "$ref": "#/$defs/OrganizationCertification" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "e.g. FIDES Supporter"
        },
        "offerings": {
          "type": "array",
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": "Pro-only: services and solutions the organization offers to customers; searchable in the Trust Explorer."
        },
        "catalogTier": {
          "type": "string",
          "enum": ["Community", "Pro"],
          "description": "Community (free) or Pro plan. Set on WordPress export from ownership linkage; Pro-only fields are omitted for Community."
        },
        "fidesManifestoSupporter": {
          "type": "boolean",
          "description": "When true, the organization is listed under FIDES Supporters on https://fides.community/manifesto/ (logo wall). Not the same as submitting the optional ratification form."
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "email": {
              "type": "string",
              "format": "email",
              "description": "Pro-only: public contact email (org modal Contact button opens mailto:)."
            },
            "bookMeetingUrl": {
              "type": "string",
              "format": "uri",
              "description": "Pro-only: scheduling URL (org modal Book a Meeting button)."
            }
          }
        },
        "ecosystemRoleCodes": {
          "type": "array",
          "uniqueItems": true,
          "description": "Optional self-declared ecosystem roles. The crawler may add issuer, VC type authority, wallet provider, or relying party roles when linked entries exist in other catalogs.",
          "items": { "$ref": "#/$defs/OrganizationEcosystemRoleCode" }
        },
        "media": {
          "$ref": "#/$defs/OrganizationMedia",
          "description": "Promotional media (Pro tier in public export)"
        }
      }
    }
  }
}
